{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synex:compatibility:certification-execution:schema:1",
  "title": "Synex bridge compatibility certification execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifactKind",
    "status",
    "complete",
    "profileId",
    "profileVersion",
    "provider",
    "providerVersion",
    "script",
    "runner",
    "flows",
    "summary",
    "disclaimer"
  ],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "artifactKind": {
      "type": "string",
      "const": "synex-compatibility-certification-execution"
    },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "complete": { "type": "boolean" },
    "profileId": { "$ref": "#/$defs/name" },
    "profileVersion": { "$ref": "#/$defs/version" },
    "provider": { "type": "string", "enum": ["qb", "qbx", "esx"] },
    "providerVersion": { "$ref": "#/$defs/version" },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeVersion", "timeoutMs"],
      "properties": {
        "kind": { "type": "string", "const": "repository-node-test" },
        "nodeVersion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/flow" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "unknown"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "skipped": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" }
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^tests/compatibility/[A-Za-z0-9_./-]+\\.test\\.(?:ts|mjs)$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "passed", "failed", "skipped", "cancelled", "todo"],
      "properties": {
        "tests": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "skipped": { "$ref": "#/$defs/count" },
        "cancelled": { "$ref": "#/$defs/count" },
        "todo": { "$ref": "#/$defs/count" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "testPath",
        "testSha256",
        "status",
        "exitCode",
        "signal",
        "durationMs",
        "assertions",
        "outputBytes",
        "outputSha256",
        "message"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/path" },
        "testPath": { "$ref": "#/$defs/path" },
        "testSha256": { "$ref": "#/$defs/hash" },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP", "UNKNOWN"] },
        "exitCode": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "null" }
          ]
        },
        "signal": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Z0-9]+$" },
            { "type": "null" }
          ]
        },
        "durationMs": { "$ref": "#/$defs/count" },
        "assertions": { "$ref": "#/$defs/assertions" },
        "outputBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "outputSha256": { "$ref": "#/$defs/hash" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    }
  }
}
