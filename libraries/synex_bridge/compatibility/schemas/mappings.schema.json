{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synex:compatibility:mappings:schema:1",
  "title": "Synex bridge compatibility mappings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "kind",
    "identity",
    "accounts",
    "groups",
    "metadata",
    "permissions",
    "forbiddenMetadataFields"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./schemas/mappings.schema.json"
    },
    "schema": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "synex-compatibility-mappings"
    },
    "identity": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "accounts": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "metadata": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "forbiddenMetadataFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "string",
      "enum": ["qb", "qbx", "esx"]
    },
    "status": {
      "type": "string",
      "enum": ["CERTIFIED", "COMPATIBLE", "PARTIAL", "UNSUPPORTED", "UNKNOWN"]
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"
    },
    "boundedValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "nullableAccountRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "provider", "entityKind", "legacyId", "nativeId", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "entityKind": {
          "type": "string",
          "enum": ["user", "character"]
        },
        "legacyId": {
          "$ref": "#/$defs/boundedValue"
        },
        "nativeId": {
          "$ref": "#/$defs/boundedValue"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "flowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "accountRef"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["deny", "account", "mint", "burn"]
        },
        "accountRef": {
          "$ref": "#/$defs/nullableAccountRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "account"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "accountRef": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "accountRef": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "provider",
        "alias",
        "currencyCode",
        "accountKey",
        "accountRole",
        "minorUnit",
        "status",
        "fundingPolicy",
        "sinkPolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "currencyCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[a-z][a-z0-9_]{1,15}$"
        },
        "accountKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 31,
          "pattern": "^[a-z][a-z0-9_]{2,30}$"
        },
        "accountRole": {
          "type": "string",
          "const": "asset"
        },
        "minorUnit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "legacyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "round": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "fundingPolicy": {
          "$ref": "#/$defs/flowPolicy"
        },
        "sinkPolicy": {
          "$ref": "#/$defs/flowPolicy"
        }
      },
      "allOf": [
        {
          "properties": {
            "fundingPolicy": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["deny", "account", "mint"]
                }
              }
            },
            "sinkPolicy": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["deny", "account", "burn"]
                }
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "provider",
        "legacyType",
        "legacyName",
        "nativeGroupKey",
        "nativeGroupType",
        "grades",
        "dutySupported",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "legacyType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "legacyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "nativeGroupKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
        },
        "nativeGroupType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$"
        },
        "grades": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacyGrade", "gradeKey"],
            "properties": {
              "legacyGrade": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "gradeKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
              }
            }
          }
        },
        "bossRoles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
          }
        },
        "dutySupported": {
          "type": "boolean"
        },
        "dutyState": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dutySupported": { "const": true } },
            "required": ["dutySupported"]
          },
          "then": {
            "required": ["dutyState"],
            "properties": { "dutyState": true }
          },
          "else": { "properties": { "dutyState": false } }
        }
      ]
    },
    "nullableNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableLength": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "provider",
        "key",
        "valueType",
        "minimum",
        "maximum",
        "maxLength",
        "storageKey",
        "status",
        "sensitive"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
        },
        "valueType": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean"]
        },
        "minimum": {
          "$ref": "#/$defs/nullableNumber"
        },
        "maximum": {
          "$ref": "#/$defs/nullableNumber"
        },
        "maxLength": {
          "$ref": "#/$defs/nullableLength"
        },
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "sensitive": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "provider", "legacyGroup", "nativePermission",
        "priority", "fallback", "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "provider": { "$ref": "#/$defs/provider" },
        "legacyGroup": {
          "type": "string", "minLength": 1, "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "nativePermission": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "fallback": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" }
      }
    }
  }
}
