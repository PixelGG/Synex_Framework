{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synex:compatibility:surfaces:schema:1",
  "title": "Synex bridge compatibility surfaces",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "kind",
    "provider",
    "providerResource",
    "providerVersion",
    "targetFrameworkApiRange",
    "upstream",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/surfaces.schema.json"
    },
    "schema": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "synex-compatibility-surfaces"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "providerResource": {
      "type": "string",
      "enum": ["synex_bridge_qb", "synex_bridge_qbx", "synex_bridge_esx"]
    },
    "providerVersion": {
      "$ref": "#/$defs/version"
    },
    "targetFrameworkApiRange": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z*<>=~^| .+-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "branch", "revision", "sources", "evidenceUrls"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}$"
        },
        "repository": {
          "type": "string",
          "minLength": 24,
          "maxLength": 128,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "const": "main"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/upstreamSource"
          }
        },
        "evidenceUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 12,
            "maxLength": 512,
            "pattern": "^https://[^\\s]+$"
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "string",
      "enum": ["qb", "qbx", "esx"]
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": ["CERTIFIED", "COMPATIBLE", "PARTIAL", "UNSUPPORTED", "UNKNOWN"]
    },
    "mode": {
      "type": "string",
      "enum": ["strict", "compat", "silent"]
    },
    "nullableIdentifier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "type",
        "status",
        "legacyVersionRange",
        "nativeMapping",
        "requiredCapability",
        "requiredAdapter",
        "adapterOperations",
        "modes",
        "deprecated",
        "tests"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "scope": {
          "type": "string",
          "enum": ["client", "server", "shared"]
        },
        "type": {
          "type": "string",
          "enum": ["export", "object", "method", "callback", "event"]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "legacyVersionRange": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9*<>=~^| .+-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeMapping": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "requiredCapability": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "requiredAdapter": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "adapterOperations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adapterOperation"
          }
        },
        "requiredCatalog": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "catalogOperations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adapterOperation"
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,255}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNSUPPORTED"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "requiredAdapter": {
                "type": "null"
              },
              "adapterOperations": {
                "type": "array",
                "maxItems": 0
              },
              "requiredCatalog": {
                "type": "null"
              },
              "catalogOperations": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requiredAdapter": {
                "type": "string"
              }
            },
            "required": ["requiredAdapter"]
          },
          "then": {
            "properties": {
              "requiredCapability": {
                "type": "string"
              },
              "adapterOperations": {
                "type": "array",
                "minItems": 1
              },
              "requiredCatalog": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "adapterOperations": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requiredCatalog": {
                "type": "string"
              }
            },
            "required": ["requiredCatalog"]
          },
          "then": {
            "properties": {
              "requiredCapability": {
                "type": "string"
              },
              "requiredAdapter": {
                "type": "null"
              },
              "catalogOperations": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "catalogOperations": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "adapterOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nativeCapabilities"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "nativeCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          }
        }
      }
    },
    "upstreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "bytes", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_./\\[\\]-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "qb" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "providerResource": { "const": "synex_bridge_qb" },
          "upstream": {
            "type": "object",
            "properties": {
              "repository": { "const": "https://github.com/qbcore-framework/qb-core" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "qbx" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "providerResource": { "const": "synex_bridge_qbx" },
          "upstream": {
            "type": "object",
            "properties": {
              "repository": { "const": "https://github.com/Qbox-project/qbx_core" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "esx" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "providerResource": { "const": "synex_bridge_esx" },
          "upstream": {
            "type": "object",
            "properties": {
              "repository": { "const": "https://github.com/esx-framework/esx_core" }
            }
          }
        }
      }
    }
  ]
}
