{
  "name": "@synex/ui",
  "version": "0.1.0",
  "description": "Synex build-time UI library and shared FiveM NUI runtime",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "npm run build:library && npm run build:runtime",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "build:playground": "vite build --config vite.playground.config.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev:playground": "vite --config vite.playground.config.ts",
    "preview:runtime": "npm run build:runtime && vite preview --config vite.runtime.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.11.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
