{
  "name": "synex-framework",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "libraries/synex_ui"
  ],
  "bin": {
    "synex": ".build/tools/cli/src/bin.js"
  },
  "synex": {
    "apiVersion": "1.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run generate && tsc --build && npm run build:ui",
    "build:ui": "npm run build --workspace @synex/ui",
    "check": "npm run generate:check && tsc --build --pretty false && npm run check:ui && npm run validate",
    "check:ui": "npm run check --workspace @synex/ui",
    "generate": "node --experimental-strip-types tools/cli/src/bin.ts contract generate",
    "generate:check": "node --experimental-strip-types tools/cli/src/bin.ts contract generate --check",
    "validate": "node --experimental-strip-types tools/cli/src/bin.ts validate",
    "test": "node tools/test-runner.mjs && npm run test:ui",
    "test:ui": "npm run test --workspace @synex/ui",
    "test:ui:visual": "npm run test:visual --workspace @synex/ui",
    "test:ui:visual:update": "npm run test:visual:update --workspace @synex/ui",
    "test:lua": "node tools/test-runner.mjs lua",
    "test:database": "node tools/test-runner.mjs database",
    "test:compatibility": "node tools/test-runner.mjs compatibility",
    "test:notify": "node tools/test-runner.mjs notify",
    "test:interact": "node tools/test-runner.mjs interact",
    "test:security": "node tools/test-runner.mjs security",
    "test:tooling": "node tools/test-runner.mjs tooling",
    "migrate": "node --experimental-strip-types tools/migrator/src/bin.ts",
    "security": "node --experimental-strip-types tools/cli/src/bin.ts security scan .",
    "certify": "node --experimental-strip-types tools/cli/src/bin.ts certify repository",
    "evidence:core-beta": "node --experimental-strip-types tools/core-beta-evidence.ts",
    "benchmark": "node --experimental-strip-types tools/cli/src/bin.ts benchmark"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "mysql2": "3.23.4"
  },
  "devDependencies": {
    "@types/luaparse": "0.2.13",
    "@types/node": "24.13.3",
    "luaparse": "0.3.1",
    "typescript": "7.0.2",
    "wasmoon": "1.16.0"
  }
}
