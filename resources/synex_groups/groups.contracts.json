      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "group_id", "subject_kind", "subject_id"],
        "properties": {
          "idempotency_key": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "group_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "subject_kind": { "enum": ["user", "character"] },
          "subject_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
