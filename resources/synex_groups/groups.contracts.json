{
  "$schema": "../../schemas/contract.schema.json",
  "schema": 1,
  "domain": "synex.groups",
  "contracts": [
    {
      "name": "synex.groups.create",
      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_groups",
      "stability": "experimental",
      "network": "none",
      "capability": "synex.groups.manage",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "group_key", "display_name", "group_type"],
        "properties": {
          "idempotency_key": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "group_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 96 },
          "group_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
          "created_by_ref": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "metadata_json": { "type": "string", "maxLength": 4096 }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "group_key", "status", "version"],
        "properties": {
          "group_id": { "type": "string" },
          "group_key": { "type": "string" },
          "status": { "const": "active" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "OPERATION_IN_PROGRESS", "GROUP_EXISTS", "WRITE_CONFLICT", "DATABASE_ERROR"],
      "idempotent": true
    },
    {
      "name": "synex.groups.get",
      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_groups",
      "stability": "experimental",
      "network": "none",
      "capability": "synex.groups.read",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id"],
        "properties": { "group_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" } }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "group_key", "display_name", "group_type", "status", "metadata_json", "version", "read_model_version", "created_at", "updated_at"],
        "properties": {
          "group_id": { "type": "string" },
          "group_key": { "type": "string" },
          "display_name": { "type": "string" },
          "group_type": { "type": "string" },
          "status": { "type": "string" },
          "created_by_ref": { "type": ["string", "null"] },
          "metadata_json": { "type": "string" },
          "version": { "type": "integer" },
          "read_model_version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "errors": ["VALIDATION_FAILED", "GROUP_NOT_FOUND", "DATABASE_ERROR"]
    },
    {
      "name": "synex.groups.add_membership",
      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_groups",
      "stability": "experimental",
      "network": "none",
      "capability": "synex.groups.manage",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "group_id", "subject_kind", "subject_id", "role_key"],
        "properties": {
          "idempotency_key": { "type": "string" },
          "group_id": { "type": "string" },
          "subject_kind": { "enum": ["user", "character"] },
          "subject_id": { "type": "string" },
          "role_key": { "type": "string", "minLength": 2, "maxLength": 48 },
