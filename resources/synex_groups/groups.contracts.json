      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "group_id", "grade_key", "display_name", "rank_value"],
        "properties": {
          "idempotency_key": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "group_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "grade_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 96 },
          "rank_value": { "type": "integer", "minimum": -32768, "maximum": 32767 },
          "actor_ref": { "type": "string", "pattern": "^[0-9a-f-]{36}$" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grade_id", "group_id", "grade_key", "display_name", "rank_value", "status", "version"],
        "properties": {
          "grade_id": { "type": "string" },
          "group_id": { "type": "string" },
          "grade_key": { "type": "string" },
          "display_name": { "type": "string" },
          "rank_value": { "type": "integer" },
          "status": { "const": "active" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "OPERATION_IN_PROGRESS", "GROUP_NOT_FOUND", "GROUP_UNAVAILABLE", "GRADE_EXISTS", "WRITE_CONFLICT", "DATABASE_ERROR"],
      "idempotent": true
    },
    {
      "name": "synex.groups.set_grade_capability",
      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_groups",
      "stability": "experimental",
      "network": "none",
      "capability": "synex.groups.grades.manage",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "grade_id", "capability", "effect"],
        "properties": {
          "idempotency_key": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "grade_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
          "effect": { "enum": ["allow", "deny"] },
          "actor_ref": { "type": "string", "pattern": "^[0-9a-f-]{36}$" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grade_id", "group_id", "capability", "effect"],
        "properties": {
          "grade_id": { "type": "string" },
          "group_id": { "type": "string" },
          "capability": { "type": "string" },
          "effect": { "enum": ["allow", "deny"] }
        }
      },
      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "OPERATION_IN_PROGRESS", "GRADE_NOT_FOUND", "GRADE_CAPABILITY_LIMIT", "WRITE_CONFLICT", "DATABASE_ERROR"],
      "idempotent": true
    },
