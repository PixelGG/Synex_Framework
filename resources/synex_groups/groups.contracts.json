      "errors": ["VALIDATION_FAILED", "IDEMPOTENCY_CONFLICT", "OPERATION_IN_PROGRESS", "MEMBERSHIP_NOT_FOUND", "MEMBERSHIP_REMOVED", "WRITE_CONFLICT", "DATABASE_ERROR"],
      "idempotent": true
