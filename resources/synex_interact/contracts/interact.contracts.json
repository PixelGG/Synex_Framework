      },
      "errors": ["INTERACT_BUNDLE_INVALID", "INTERACT_BUNDLE_CONFLICT", "INTERACT_OWNER_STALE", "INTERACT_RATE_LIMITED", "INTERACT_UNAVAILABLE"],
      "idempotent": false,
