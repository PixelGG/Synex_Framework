      "idempotent": true,
      "rateLimit": { "capacity": 28, "refillPerSecond": 6 }
    },
    {
      "name": "synex.interact.discovery.entities",
      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_interact",
      "stability": "internal",
      "network": "client-to-server",
      "sessionStates": ["ACTIVE"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discoveryRevision"],
        "properties": {
          "discoveryRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "discoveryRevision", "projectionRevision", "sourceGeneration", "bucket", "truncated", "entities"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "discoveryRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "projectionRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "sourceGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "bucket": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
          "truncated": { "type": "boolean" },
          "entities": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entityRef", "netId", "entityType", "model", "bucket", "position", "heading"],
              "properties": {
                "entityRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entityId", "generation"],
                  "properties": {
                    "entityId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" },
                    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                  }
                },
                "netId": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "entityType": { "enum": ["vehicle", "ped", "object"] },
                "model": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "archetype": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]+$" },
                "bucket": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "z"],
                  "properties": {
                    "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
                    "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
                    "z": { "type": "number", "minimum": -20000, "maximum": 20000 }
                  }
                },
                "heading": { "type": "number", "minimum": -360000, "maximum": 360000 }
              }
            }
          }
        }
      },
      "errors": ["INTERACT_INVALID_REQUEST", "INTERACT_DISCOVERY_STALE", "INTERACT_LEASE_STALE", "INTERACT_TARGET_STALE", "INTERACT_RATE_LIMITED", "INTERACT_PAYLOAD_TOO_LARGE", "INTERACT_UNAVAILABLE"],
      "idempotent": true,
      "rateLimit": { "capacity": 2, "refillPerSecond": 0.5 }
    },
    {
      "name": "synex.interact.lease.request",
