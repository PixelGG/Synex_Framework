          "key": { "type": "string", "minLength": 3, "maxLength": 128 },
          "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "ownerResource": { "type": "string", "minLength": 3, "maxLength": 64 },
          "ownerEpoch": { "type": "integer", "minimum": 1 },
          "activated": { "const": true }
