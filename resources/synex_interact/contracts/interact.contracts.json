              "sensorTicks": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "candidatesSeen": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "expensiveChecks": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "intentChanges": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "promptsShown": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "bloomOpened": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "leaseRequests": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "transportFailures": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
              "providerTimeouts": { "type": "integer", "minimum": 0, "maximum": 1000000000000 }
            }
          },
          "gauges": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidateCount": { "type": "number", "minimum": 0, "maximum": 128 },
              "sensorIntervalMs": { "type": "number", "minimum": 0, "maximum": 10000 },
              "expensiveCandidateCount": { "type": "number", "minimum": 0, "maximum": 8 },
              "sensorDurationMs": { "type": "number", "minimum": 0, "maximum": 60000 },
              "providerDurationMs": { "type": "number", "minimum": 0, "maximum": 60000 },
              "intentScoringDurationMs": { "type": "number", "minimum": 0, "maximum": 60000 }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted", "duplicate", "nextReportAfterMs"],
        "properties": {
          "accepted": { "const": true },
          "duplicate": { "type": "boolean" },
          "nextReportAfterMs": { "type": "integer", "minimum": 5000, "maximum": 60000 }
        }
      },
      "errors": ["INTERACT_INVALID_REQUEST", "INTERACT_RATE_LIMITED", "INTERACT_UNAVAILABLE"],
      "idempotent": true,
      "rateLimit": { "capacity": 2, "refillPerSecond": 0.2 }
    }
  ]
}
