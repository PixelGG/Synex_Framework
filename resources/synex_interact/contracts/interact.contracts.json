              },
              "model": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "bone": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "anyOf": [
              {
                "type": "object",
                "required": ["kind", "worldRef"],
                "properties": {
                  "kind": { "const": "world" },
                  "worldRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["key", "revision"],
                    "properties": {
                      "key": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_.-]*$" },
                      "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                      "kind": { "enum": ["anchor", "door", "portal"] }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "entityRef"],
                "properties": {
                  "kind": { "const": "entity" },
                  "entityRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["entityId", "generation"],
                    "properties": {
                      "entityId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" },
                      "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "netId", "model"],
                "properties": {
                  "kind": { "const": "ambient" },
                  "netId": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "model": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                  "bone": { "type": "string", "minLength": 1, "maxLength": 64 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "bindingKey"],
                "properties": {
                  "kind": { "const": "static" },
                  "bindingKey": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" },
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y", "z"],
                    "properties": {
                      "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
                      "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
                      "z": { "type": "number", "minimum": -20000, "maximum": 20000 }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "bindingKey"],
                "properties": {
                  "kind": { "const": "dynamic" },
                  "bindingKey": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" },
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y", "z"],
                    "properties": {
                      "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
                      "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
                      "z": { "type": "number", "minimum": -20000, "maximum": 20000 }
                    }
                  }
                }
              }
            ]
          },
          "slotKey": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][A-Za-z0-9_.-]*$" },
          "clientRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
