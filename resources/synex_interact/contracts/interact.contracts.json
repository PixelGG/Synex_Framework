            "type": "object",
            "additionalProperties": false,
            "required": ["key", "revision"],
            "properties": {
              "key": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_.-]*$" },
              "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "sessionId": { "type": "string", "minLength": 8, "maxLength": 96 },
          "requiredParticipants": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
        }
