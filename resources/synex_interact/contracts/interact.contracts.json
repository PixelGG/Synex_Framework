      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leaseId", "nonce", "state", "intent", "expiresAt", "sessionId"],
        "properties": {
          "leaseId": { "type": "string", "minLength": 8, "maxLength": 96 },
          "nonce": { "type": "string", "minLength": 8, "maxLength": 96 },
          "state": { "enum": ["ISSUED", "WAITING"] },
