      "version": "1.0.0",
      "kind": "rpc",
      "provider": "synex_interact",
      "stability": "internal",
      "network": "client-to-server",
      "sessionStates": ["ACTIVE"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knownRevision", "snapshotRevision", "page"],
        "properties": {
          "knownRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "snapshotRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "page": { "type": "integer", "minimum": 1, "maximum": 24 }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "revision", "unchanged", "page", "pageCount", "complete", "objectCount", "totalBytes", "payload"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "unchanged": { "type": "boolean" },
          "page": { "type": "integer", "minimum": 1, "maximum": 24 },
          "pageCount": { "type": "integer", "minimum": 1, "maximum": 24 },
          "complete": { "type": "boolean" },
          "objectCount": { "type": "integer", "minimum": 0, "maximum": 2048 },
