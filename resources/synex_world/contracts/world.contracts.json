        "properties": {
          "instanceId": { "type": "string", "minLength": 8, "maxLength": 64 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 36, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instanceId", "template", "ownerResource", "ownerEpoch", "state",
          "capacity", "members", "createdAt", "revision", "cleanupPolicy",
          "transitionedMembers", "replayed"],
        "properties": {
          "instanceId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" },
          "template": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "key", "revision"],
            "properties": {
              "kind": { "const": "instance_template" },
              "key": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_.-]*$" },
              "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
            }
          },
          "ownerResource": { "type": "string", "minLength": 7, "maxLength": 64, "pattern": "^synex_[a-z0-9_]+$" },
          "ownerEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "state": { "enum": ["CREATING", "READY", "ACTIVE", "DRAINING", "CLOSED", "FAILED"] },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 256 },
          "members": { "type": "integer", "minimum": 0, "maximum": 256 },
          "createdAt": { "type": "string", "minLength": 20, "maxLength": 32 },
          "expiresAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "cleanupPolicy": { "enum": ["empty_ttl", "owner_stop", "manual"] },
          "transitionedMembers": { "type": "integer", "minimum": 0, "maximum": 256 },
          "replayed": { "type": "boolean" },
          "bucketRef": {
            "type": "object", "additionalProperties": false,
            "required": ["bucket", "generation"],
            "properties": {
              "bucket": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
              "generation": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$" }
            }
          }
        }
      },
      "errors": ["CONCURRENT_MODIFICATION", "CORE_UNAVAILABLE", "FORBIDDEN", "INSTANCE_BUCKET_UNAVAILABLE", "INSTANCE_NOT_FOUND", "INTERNAL_ERROR", "INVALID_ARGUMENT", "QUERY_LIMIT_EXCEEDED", "RATE_LIMITED", "STALE_RESOURCE", "STALE_WORLD_REF", "TRANSITION_GRANT_REPLAYED", "UNAVAILABLE", "WORLD_ACCESS_DENIED", "WORLD_REFERENCE_INVALID"],
      "idempotent": true,
      "rateLimit": { "capacity": 8, "refillPerSecond": 2 }
    }
  ]
}
