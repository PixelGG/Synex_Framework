{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synex.dev/schemas/resource.schema.json",
  "title": "Synex resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "synex",
    "critical",
    "capabilities",
    "services",
    "contracts",
    "events",
    "hooks",
    "dependencies",
    "migrations",
    "dataOwnership",
    "stateSnapshot"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^synex_[a-z0-9_]+$",
      "maxLength": 64
    },
    "version": { "$ref": "#/$defs/semver" },
    "synex": { "$ref": "#/$defs/range" },
    "critical": { "type": "boolean" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "controlProvider": { "$ref": "#/$defs/controlProvider" },
    "worldBundles": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 18,
        "maxLength": 240,
        "pattern": "^world/[A-Za-z0-9._/-]+\\.world\\.json$",
        "allOf": [
          { "not": { "pattern": "(?:^|/)\\.{1,2}(?:/|$)" } },
          { "not": { "pattern": "//" } }
        ]
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provide", "require", "optional"],
      "properties": {
        "provide": { "$ref": "#/$defs/serviceList" },
        "require": { "$ref": "#/$defs/serviceList" },
        "optional": { "$ref": "#/$defs/serviceList" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provide", "consume"],
      "properties": {
        "provide": { "$ref": "#/$defs/nameList" },
        "consume": { "$ref": "#/$defs/nameList" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publish", "subscribe"],
      "properties": {
        "publish": { "$ref": "#/$defs/eventPatternList" },
        "subscribe": { "$ref": "#/$defs/eventPatternList" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "run"],
      "properties": {
        "register": { "$ref": "#/$defs/eventPatternList" },
        "run": { "$ref": "#/$defs/eventPatternList" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "development"],
      "properties": {
        "required": { "$ref": "#/$defs/dependencyList" },
        "optional": { "$ref": "#/$defs/dependencyList" },
        "development": { "$ref": "#/$defs/dependencyList" }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "transactional"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{3}_[a-z0-9_]+$",
            "maxLength": 96
          },
          "path": {
            "type": "string",
            "pattern": "^migrations/[A-Za-z0-9._/-]+\\.sql$",
            "maxLength": 240,
            "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" }
          },
          "transactional": { "type": "boolean" }
        }
      }
    },
    "dataOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "characterDelete"],
      "properties": {
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^synex_[a-z0-9_]+$",
            "maxLength": 64
          }
        },
        "characterDelete": { "enum": ["none", "delete", "anonymize", "retain", "block"] }
      }
    },
    "stateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "schemaVersion"],
      "properties": {
        "supported": { "type": "boolean" },
        "schemaVersion": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?$"
    },
    "range": {
      "type": "string",
      "pattern": "^(?:\\^|~|>=|<=|>|<|=)?\\s*(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\s+(?:\\^|~|>=|<=|>|<|=)?\\s*(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*$",
      "maxLength": 96
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "service": {
      "type": "string",
      "pattern": "^synex\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$",
      "maxLength": 128
    },
    "controlProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "namespace",
        "label",
        "category",
        "version",
        "operations",
        "views"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "namespace": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/semver" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/controlProviderOperation" }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/controlProviderView" }
        }
      }
    },
    "controlProviderOperation": {
      "enum": [
        "summary",
        "health",
        "list",
        "inspect",
        "search",
        "metrics",
        "findings",
        "simulate"
      ]
    },
    "controlProviderView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "operation", "presentation", "accessClass"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "operation": { "$ref": "#/$defs/controlProviderOperation" },
        "presentation": {
          "enum": [
            "metrics",
            "key-value",
            "table",
            "detail",
            "timeline",
            "graph",
            "findings"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "accessClass": {
          "enum": ["general", "audit", "security", "financial", "identifiers"]
        },
        "input": { "$ref": "#/$defs/controlProviderInput" },
        "search": { "$ref": "#/$defs/controlProviderSearch" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "search" } }, "required": ["operation"] },
          "then": { "properties": { "search": {} }, "required": ["search"] },
          "else": { "not": { "required": ["search"] } }
        }
      ]
    },
    "controlProviderSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/controlProviderSearchKind" }
        }
      }
    },
    "controlProviderSearchKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modes", "accessClass"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["exact", "prefix"] }
        },
        "accessClass": {
          "enum": ["general", "audit", "security", "financial", "identifiers"]
        }
      }
    },
    "controlProviderInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/controlProviderInputField" }
        }
      }
    },
    "controlProviderInputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "source", "type", "format", "required"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "source": { "enum": ["id", "filter"] },
        "type": { "enum": ["string", "integer", "boolean"] },
        "format": {
          "enum": [
            "identifier",
            "lookup",
            "uuid",
            "resource",
            "capability",
            "action",
            "integer",
            "numeric-string",
            "boolean",
            "text"
          ]
        },
        "required": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 128 },
        "minimum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "maximum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": {
            "properties": {
              "format": { "enum": ["identifier", "lookup", "uuid", "resource", "capability", "action", "numeric-string", "text"] },
              "minimum": false,
              "maximum": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "integer" } }, "required": ["type"] },
          "then": {
            "properties": {
              "format": { "const": "integer" },
              "minLength": false,
              "maxLength": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": {
            "properties": {
              "format": { "const": "boolean" },
              "minLength": false,
              "maxLength": false,
              "minimum": false,
              "maximum": false
            }
          }
        }
      ]
    },
    "nameList": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "eventPattern": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+(?:\\.\\*)?$",
      "maxLength": 128
    },
    "eventPatternList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/eventPattern" }
    },
    "serviceList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/service" }
    },
    "dependencyList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 64
          },
          "version": { "$ref": "#/$defs/range" }
        }
      }
    }
  }
}
